{
  "providers": {
    "openai-codex": {
      "modelOverrides": {
        "gpt-5.5": {
          "thinkingLevelMap": {
            "minimal": null
          }
        },
        "gpt-5.4": {
          "thinkingLevelMap": {
            "minimal": null
          }
        },
        "gpt-5.4-mini": {
          "thinkingLevelMap": {
            "minimal": null
          }
        },
        "gpt-5.6-sol": {
          "thinkingLevelMap": {
            "minimal": null,
            "max": null
          }
        },
        "gpt-5.6-terra": {
          "thinkingLevelMap": {
            "minimal": null,
            "max": null
          }
        },
        "gpt-5.6-luna": {
          "thinkingLevelMap": {
            "minimal": null
          }
        }
      }
    },
    "cliproxy": {
      "baseUrl": "http://127.0.0.1:8317/v1",
      "api": "openai-responses",
      "apiKey": "!cat /home/user/.pi/agent/secrets/cliproxy-api-key",
      "models": [
        {
          "id": "gpt-5.6-sol",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 272000
        },
        {
          "id": "gpt-5.6-luna",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 272000
        }
      ]
    },
    "anthropic": {
      "baseUrl": "http://daig.prod.pora.srv.corp",
      "apiKey": "$ANTHROPIC_AUTH_TOKEN",
      "headers": {
        "Authorization": "Bearer $ANTHROPIC_AUTH_TOKEN"
      }
    }
  }
}
