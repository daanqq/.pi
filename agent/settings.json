{
  "lastChangelogVersion": "0.83.0",
  "defaultThinkingLevel": "low",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "-skills/librarian/SKILL.md"
      ]
    },
    "npm:pi-system-prompt",
    "npm:@ff-labs/pi-fff",
    "npm:@plannotator/pi-extension",
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "-index.ts"
      ]
    },
    "git:github.com/algal/pi-openai-server-compaction"
  ],
  "hideThinkingBlock": false,
  "theme": "alabaster",
  "quietStartup": false,
  "compaction": {
    "enabled": false
  },
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna"
  ],
  "externalEditor": "code --wait",
  "transport": "auto",
  "collapseChangelog": true,
  "treeFilterMode": "default",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "editorPaddingX": 0,
  "showHardwareCursor": false,
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": true,
  "autocompleteMaxVisible": 10,
  "followUpMode": "all",
  "enableInstallTelemetry": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "-extensions/compact.ts",
    "-extensions/answer/index.ts",
    "-extensions/generation-stats.ts",
    "-extensions/open-last-agent-response.ts",
    "-extensions/agents-local.ts",
    "-extensions/handoff.ts",
    "-extensions/codex-review.ts",
    "-extensions/workflows/index.ts",
    "-extensions/background-terminals/index.ts",
    "-extensions/session-delete.ts",
    "-extensions/branch-summary-model.ts"
  ],
  "httpIdleTimeoutMs": 120000,
  "defaultProjectTrust": "always",
  "outputPad": 0,
  "skills": [
    "-skills/background-terminals/SKILL.md"
  ]
}