{
  "lastChangelogVersion": "0.85.1",
  "defaultThinkingLevel": "medium",
  "defaultProvider": "cliproxy",
  "defaultModel": "cliproxy/sol",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "-skills/librarian/SKILL.md"
      ]
    },
    "npm:pi-system-prompt",
    "npm:@ff-labs/pi-fff",
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": [
        "-skills/plannotator/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "-index.ts"
      ],
      "skills": [
        "-skills/mcp-scripting/SKILL.md"
      ]
    },
    "git:github.com/daanqq/pi-openai-server-compaction-cliproxy"
  ],
  "hideThinkingBlock": false,
  "theme": "alabaster",
  "quietStartup": false,
  "compaction": {
    "enabled": true
  },
  "enabledModels": [
    "cliproxy/sol",
    "cliproxy/luna",
    "openrouter/z-ai/glm-5.3-flash"
  ],
  "externalEditor": "code --wait",
  "transport": "auto",
  "collapseChangelog": true,
  "treeFilterMode": "no-tools",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "editorPaddingX": 0,
  "showHardwareCursor": false,
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": false,
  "autocompleteMaxVisible": 5,
  "followUpMode": "all",
  "enableInstallTelemetry": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "+extensions/balance.ts",
    "+extensions/00-ui-footer.ts",
    "+extensions/00-ui-header.ts",
    "+extensions/00-ui-editor.ts"
  ],
  "httpIdleTimeoutMs": 120000,
  "defaultProjectTrust": "always",
  "outputPad": 0,
  "fullscreenScrollbar": "auto",
  "tuiMode": "fullscreen",
  "showCacheMissNotices": true,
  "skills": [
    "-skills/coding-discipline/SKILL.md"
  ],
  "themes": [
    "-themes/poimandres.json"
  ],
  "fullscreenExitOutput": "transcript",
  "modelThinkingLevels": {
    "cliproxy/sol": "medium",
    "cliproxy/luna": "high",
    "openrouter/z-ai/glm-5.3-flash": "high"
  },
  "warnings": {
    "anthropicExtraUsage": false
  },
  "markdown": {
    "mermaid": "final"
  },
  "fullscreenCopyOnSelect": true
}