{
  "lastChangelogVersion": "0.80.3",
  "defaultThinkingLevel": "low",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-rtk-optimizer",
    "npm:@ff-labs/pi-fff",
    "git:github.com/daanqq/pi-diff-review",
    "npm:pi-schedule-prompt"
  ],
  "hideThinkingBlock": false,
  "theme": "alabaster",
  "quietStartup": true,
  "compaction": {
    "enabled": false
  },
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "deepseek/deepseek-v4-pro"
  ],
  "transport": "sse",
  "collapseChangelog": true,
  "treeFilterMode": "default",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "editorPaddingX": 1,
  "showHardwareCursor": false,
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": false,
  "autocompleteMaxVisible": 10,
  "followUpMode": "all",
  "enableInstallTelemetry": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "-extensions/compact.ts",
    "-extensions/answer/index.ts",
    "-extensions/generation-stats.ts"
  ],
  "httpIdleTimeoutMs": 120000,
  "defaultProjectTrust": "always",
  "skills": [
    "-skills/grilling/SKILL.md",
    "-skills/make-change-easy/SKILL.md",
    "-skills/twelve-rules/SKILL.md"
  ],
  "outputPad": 1
}