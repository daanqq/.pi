{
  "lastChangelogVersion": "0.80.10",
  "defaultThinkingLevel": "high",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "-skills/librarian/SKILL.md"
      ]
    },
    "git:github.com/daanqq/pi-diff-review",
    "npm:pi-system-prompt"
  ],
  "hideThinkingBlock": false,
  "theme": "alabaster",
  "quietStartup": false,
  "compaction": {
    "enabled": false
  },
  "enabledModels": [
    "deepseek/deepseek-v4-pro",
    "openai-codex/gpt-5.6-sol"
  ],
  "externalEditor": "code --wait",
  "transport": "sse",
  "collapseChangelog": true,
  "treeFilterMode": "default",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "editorPaddingX": 0,
  "showHardwareCursor": false,
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": true,
  "autocompleteMaxVisible": 10,
  "followUpMode": "all",
  "enableInstallTelemetry": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "-extensions/compact.ts",
    "-extensions/answer/index.ts",
    "-extensions/generation-stats.ts",
    "-extensions/open-last-agent-response.ts",
    "-extensions/agents-local.ts",
    "-extensions/handoff.ts",
    "-extensions/session-hygiene.ts",
    "-extensions/codex-review.ts"
  ],
  "httpIdleTimeoutMs": 120000,
  "defaultProjectTrust": "always",
  "outputPad": 0
}