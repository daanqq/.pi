{
  "lastChangelogVersion": "0.86.0",
  "defaultThinkingLevel": "medium",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "packages": [
    "npm:@ff-labs/pi-fff",
    "npm:@plannotator/pi-extension",
    "npm:pi-mcp-adapter",
    "npm:pi-context-view",
    "npm:@ogulcancelik/pi-codex-compaction"
  ],
  "hideThinkingBlock": false,
  "theme": "light",
  "quietStartup": true,
  "compaction": {
    "enabled": false
  },
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-6-astra"
  ],
  "externalEditor": "code --wait",
  "transport": "websocket-cached",
  "collapseChangelog": true,
  "treeFilterMode": "no-tools",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "editorPaddingX": 0,
  "showHardwareCursor": false,
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": false,
  "autocompleteMaxVisible": 5,
  "followUpMode": "all",
  "enableInstallTelemetry": true,
  "doubleEscapeAction": "tree",
  "httpIdleTimeoutMs": 120000,
  "defaultProjectTrust": "always",
  "outputPad": 0,
  "fullscreenScrollbar": "auto",
  "tuiMode": "fullscreen",
  "showCacheMissNotices": true,
  "fullscreenExitOutput": "resume-hint",
  "modelThinkingLevels": {
    "openai-codex/gpt-6-astra": "low",
    "openai-codex/gpt-5.6-sol": "medium",
    "openai-codex/gpt-5.6-luna": "high",
    "openrouter/z-ai/glm-5.3-flash": "high"
  },
  "markdown": {
    "mermaid": "final"
  },
  "fullscreenCopyOnSelect": true,
  "skills": [
    "-skills/web-search/**",
    "-skills/firecrawl-fetch/**",
    "-skills/analyze-eutp/SKILL.md",
    "-skills/dnd-kit-implementation/SKILL.md",
    "-skills/eutp-worktree/SKILL.md",
    "-skills/eutp-worktree-transfer/SKILL.md",
    "-skills/fix-gitlab-mr-conflicts/SKILL.md",
    "-skills/fix-gitlab-mr-review/SKILL.md",
    "-skills/fix-merge-conflicts/SKILL.md",
    "-skills/mr-review/SKILL.md",
    "-skills/optimize-images/SKILL.md",
    "-skills/herdr-build/SKILL.md",
    "-skills/vercel-react-best-practices/SKILL.md",
    "-skills/typescript-best-practices/SKILL.md",
    "-skills/update-skills/SKILL.md"
  ]
}
