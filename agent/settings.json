{
  "lastChangelogVersion": "0.85.0",
  "defaultThinkingLevel": "medium",
  "defaultProvider": "cliproxy",
  "defaultModel": "cliproxy/sol",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "-skills/librarian/SKILL.md"
      ]
    },
    "npm:pi-system-prompt",
    "npm:@ff-labs/pi-fff",
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": [
        "-skills/plannotator/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "-index.ts"
      ]
    },
    "git:github.com/algal/pi-openai-server-compaction"
  ],
  "hideThinkingBlock": false,
  "theme": "alabaster",
  "quietStartup": false,
  "compaction": {
    "enabled": false
  },
  "enabledModels": [
    "cliproxy/astra",
    "cliproxy/sol",
    "cliproxy/luna",
    "openrouter/z-ai/glm-5.3-flash"
  ],
  "externalEditor": "code --wait",
  "transport": "auto",
  "collapseChangelog": true,
  "treeFilterMode": "default",
  "steeringMode": "all",
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "editorPaddingX": 0,
  "showHardwareCursor": false,
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": false,
  "autocompleteMaxVisible": 10,
  "followUpMode": "all",
  "enableInstallTelemetry": true,
  "doubleEscapeAction": "tree",
  "extensions": [
    "+extensions/balance.ts"
  ],
  "httpIdleTimeoutMs": 120000,
  "defaultProjectTrust": "always",
  "outputPad": 0,
  "fullscreenScrollbar": "auto",
  "tuiMode": "regular",
  "showCacheMissNotices": true
}